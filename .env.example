# Ativar captura de e-mails externos (IMAP)
IMAP_ENABLED=false

# Host IMAP da conta corporativa
IMAP_HOST=imap.seudominio.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=caixa@fcaadvogados.com.br
IMAP_PASS=troque-por-senha-de-app
IMAP_MAILBOX=INBOX

# Intervalo de sincronização (ms)
IMAP_POLL_INTERVAL_MS=60000

# Marcar como lidos no servidor externo após importar
IMAP_MARK_SEEN=true

# Porta do backend local
PORT=8000

# Google Drive integration
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_NAME=SEBAX
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_TARGET_EMAIL=licitacoesbomconselhope@gmail.com
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://localhost:8000/api/drive/oauth/callback
GOOGLE_DRIVE_REFRESH_TOKEN=

# Retenção do histórico de comunicação
COMMUNICATION_RETENTION_DAYS=7
